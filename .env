# Production frontend example. Copy to .env.production and replace schedule
# with the deployed SharePoint site code. TXT is the safe active example.
VITE_SP_HOST=portal.army.idf
VITE_SP_SITE_CODE=schedule
VITE_SP_SITE_DB_FOLDER=siteDB
VITE_SP_USERS_DB_FOLDER=/sites/schedule/siteUsersDb
VITE_SP_BOOTSTRAP_LIBRARY=SiteAssets
VITE_SP_BOOTSTRAP_FOLDER=sitebuilder-bootstrap
VITE_SP_SITE_ASSETS_FOLDER=siteAssets
VITE_SP_IMAGES_FOLDER=images
VITE_SP_WIDGETS_DB_TARGET=users

# Optional overrides, normally auto-derived.
VITE_SP_SITE_API_ROOT=/sites/schedule
VITE_SITE_BASE_URL=https://portal.army.idf/sites/schedule/siteDB/dist

# Exactly one active persistence backend. A deployed site stays on TXT unless
# its production/runtime configuration explicitly selects Mongo.
VITE_STORAGE_BACKEND=txt
VITE_SITE_ID=schedule
VITE_BACKEND_API_URL=

# Mongo production alternative: replace the three active values above with
# these values. The URL must be reachable from users' browsers and use HTTPS
# when the SharePoint page uses HTTPS. Never put Mongo credentials in VITE_*.
# VITE_STORAGE_BACKEND=mongo
# VITE_SITE_ID=schedule
# VITE_BACKEND_API_URL=https://your-approved-backend.example

# Logging.
VITE_SP_VERBOSE_LOG=true
VITE_SP_APP_LOGS=true
VITE_SP_APP_WARN_ERROR_LOGS=true
VITE_SP_PERMISSIONS_SETUP_LOGS=true
VITE_SP_LIBRARY_PROVISIONING_LOGS=true
VITE_SP_ADMIN_MANAGEMENT_LOGS=true
VITE_SP_ENABLE_OWNERS_MANAGEMENT_LOGS=true
VITE_SP_LOG_FETCH_ADMINS=true
VITE_SP_LOG_FETCH_ADMINS_VERBOSE=true
VITE_SP_BOOTSTRAP_SETUP_LOGS=true
VITE_ALPHA_AI_DEBUG=true

# Optional Alpha Team footer/admin banner data.
VITE_APP_VERSION=0.2.3
VITE_ALPHA_TEAM_NAME_HE=צוות אלפא
VITE_ALPHA_TEAM_NAME_EN=Alpha Team
VITE_ALPHA_TEAM_LOGO_PATH=/images/alphalogo1.png
VITE_ALPHA_TEAM_EMAIL=
VITE_ALPHA_TEAM_SITE_URL=

# Production/deploy behavior. The local .env.local.example disables deploy.
VITE_AUTO_DEPLOY=false
VITE_AUTO_DEPLOY_STRICT=false
VITE_USE_MOCK=false
VITE_ALLOW_MOCK_ADMIN_BYPASS=false

# Alpha AI proxy integration.
VITE_ALPHA_AI_ENABLED=true
VITE_UI_SHOW_AI_UI=true
VITE_UI_SHOW_GLOBAL_AI_COPILOT=true
VITE_UI_SHOW_WIDGET_AI_BUTTONS=true
# Each local widget assistant also requires its own explicit opt-in.
VITE_UI_SHOW_AI_EVENTS=true
VITE_UI_SHOW_AI_ALERTS=true
VITE_UI_SHOW_AI_OUTSTANDING=true
VITE_UI_SHOW_AI_COUNTDOWN=true
VITE_UI_SHOW_AI_NEWS=true
VITE_UI_SHOW_AI_PHONEBOOK=true
VITE_UI_SHOW_AI_SHUTTLES=true
VITE_UI_SHOW_AI_POLLS=true
VITE_UI_SHOW_AI_CELEBRATIONS=true
VITE_UI_SHOW_AI_HERITAGE=true
VITE_UI_SHOW_AI_TIPS=true
VITE_UI_SHOW_ORG_CHART_AI_IMPORT=true
VITE_UI_SHOW_QUICK_DESIGN_COMPOSER=true
VITE_ALPHA_AI_API_BASE=http://localhost:3000/api
VITE_ALPHA_AI_MODEL=gpt-4o
VITE_ALPHA_AI_FALLBACK_MODELS=claude-3-haiku-20240307,gemini-1.5-pro
VITE_ALPHA_AI_STREAM_MODEL=any
VITE_ALPHA_AI_STREAM_ENDPOINT=/ai/stream
VITE_ALPHA_AI_FILE_MODEL=grok-2-vision-1212
VITE_ALPHA_AI_TIMEOUT_MS=30000
VITE_ALPHA_AI_STREAM_TIMEOUT_MS=120000
VITE_ALPHA_AI_API_TOKEN=

# Never add VITE_SITE_BUILDER_DEV_API_KEY to a production environment. It is
# accepted only during local development and belongs in ignored .env.local.

# DEV-only local AI engine (browser-visible switch only).
# Requires a Vite development runtime; ignored in every production build.
# The provider credentials are SERVER-ONLY and live in server/.env.local or in
# ~/.config/site-builder/dev-ai.env. Never place GROQ_API_KEY in a VITE_ variable.
VITE_DEV_AI_ENABLED=true
