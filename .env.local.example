# Local TXT development profile.
# Copy to .env.local, then run: npm run dev:vite
# TXT uses browser localStorage in local development, so no API or Mongo is required.
VITE_STORAGE_BACKEND=txt
VITE_BACKEND_API_URL=
VITE_SITE_ID=local-dev-site
VITE_SITE_BUILDER_DEV_API_KEY=

VITE_AUTO_DEPLOY=false
VITE_ALLOW_MOCK_ADMIN_BYPASS=true
VITE_USE_MOCK=false

# Keep unrelated production integrations disabled locally.
VITE_ALPHA_AI_ENABLED=false
VITE_UI_SHOW_AI_UI=false
VITE_UI_SHOW_WIDGET_AI_BUTTONS=false
VITE_UI_SHOW_AI_EVENTS=false
VITE_UI_SHOW_AI_ALERTS=false
VITE_UI_SHOW_AI_OUTSTANDING=false
VITE_UI_SHOW_AI_COUNTDOWN=false
VITE_UI_SHOW_AI_NEWS=false
VITE_UI_SHOW_AI_PHONEBOOK=false
VITE_UI_SHOW_AI_SHUTTLES=false
VITE_UI_SHOW_AI_POLLS=false
VITE_UI_SHOW_AI_CELEBRATIONS=false
VITE_UI_SHOW_AI_HERITAGE=false
VITE_UI_SHOW_AI_TIPS=false
VITE_UI_SHOW_ORG_CHART_AI_IMPORT=false
VITE_ALPHA_AI_API_TOKEN=
# Optional: required only by a verified visual file-upload transport. Extracted
# text uses the normal model, including the server-selected DEV AI model.
VITE_ALPHA_AI_FILE_MODEL=

# ---------------------------------------------------------------------------
# DEV-only local AI engine (Ollama / Groq).
# BROWSER-VISIBLE flag. This is the only DEV AI variable that may ever carry a
# VITE_ prefix, and it is a boolean switch - never a credential.
# When true AND the app runs in a Vite development runtime, every existing AI
# feature transparently uses the local DEV AI gateway at /api/dev-ai instead of
# the production AI backend. It is ignored entirely in a production build.
# The matching server-side flags live in server/.env.local (see that file).
# NEVER put GROQ_API_KEY - or any provider credential - in a VITE_ variable.
VITE_DEV_AI_ENABLED=false
