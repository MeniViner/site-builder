# Local development profile: Mongo API + local Mongo (Docker or an already
# running local Mongo instance). Copy this file to .env.local.
VITE_STORAGE_BACKEND=mongo
VITE_BACKEND_API_URL=http://127.0.0.1:3001
VITE_SITE_ID=local-dev-site
# Development only. The production build wrapper always removes this value.
VITE_SITE_BUILDER_DEV_API_KEY=dev-local-api-key
VITE_AUTO_DEPLOY=false
# Development-only bridge that renders file:// folders in the styled browser.
VITE_LOCAL_FILE_BRIDGE=true

# Keep unrelated production integrations disabled in local development.
VITE_ALPHA_AI_ENABLED=false
VITE_ALPHA_AI_API_TOKEN=
VITE_ALLOW_MOCK_ADMIN_BYPASS=true
VITE_USE_MOCK=false

# TXT/localStorage alternative (no API or Mongo required): change only these
# values, restart Vite, and keep the bridge enabled.
# VITE_STORAGE_BACKEND=txt
# VITE_BACKEND_API_URL=
# VITE_SITE_BUILDER_DEV_API_KEY=
