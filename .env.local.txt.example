# Local TXT development profile.
# Copy to .env.local, then run: npm run dev:vite
# In development, TXT uses browser localStorage so SharePoint is not required.
VITE_STORAGE_BACKEND=txt
VITE_BACKEND_API_URL=
VITE_SITE_ID=local-dev-site
VITE_SITE_BUILDER_DEV_API_KEY=

VITE_AUTO_DEPLOY=false
VITE_ALLOW_MOCK_ADMIN_BYPASS=true
VITE_USE_MOCK=false

# Keep unrelated production integrations disabled locally.
VITE_ALPHA_AI_ENABLED=false
VITE_ALPHA_AI_API_TOKEN=
VITE_UI_SHOW_AI_UI=false
VITE_UI_SHOW_WIDGET_AI_BUTTONS=false
VITE_UI_SHOW_AI_EVENTS=false
VITE_UI_SHOW_AI_ALERTS=false
VITE_UI_SHOW_AI_OUTSTANDING=false
VITE_UI_SHOW_AI_COUNTDOWN=false
VITE_UI_SHOW_AI_NEWS=false
VITE_UI_SHOW_AI_PHONEBOOK=false
VITE_UI_SHOW_AI_SHUTTLES=false
VITE_UI_SHOW_AI_POLLS=false
VITE_UI_SHOW_AI_CELEBRATIONS=false
VITE_UI_SHOW_AI_HERITAGE=false
VITE_UI_SHOW_AI_TIPS=false
