# Server Settings
PORT=3000
NODE_ENV=development

# Security
FRONTEND_DOMAIN=http://localhost:5173
ALLOW_ALL_ORIGINS=true
# Local development only. Production defaults to guarded when this value is omitted.
DISABLE_AUTH_GUARD=true
TRUST_PROXY=true
API_SECRET_TOKEN=

# API Keys, comma-separated for key rotation.
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
GEMINI_API_KEYS=
FALLBACK_MODELS=gpt-4o,gemini-1.5-pro,claude-3-haiku-20240307

# Timeouts
DEFAULT_TIMEOUT_MS=15000
STREAM_TIMEOUT_MS=45000
AI_FILE_IMPORT_TIMEOUT_MS=90000

# File import limits. Files are held in memory only and are never stored permanently.
AI_FILE_IMPORT_MAX_MB=20
AI_FILE_EXTRACTED_TEXT_MAX_CHARS=200000
