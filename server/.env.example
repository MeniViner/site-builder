# Mongo API production example. Copy to the server's real environment file or
# secret manager and replace every placeholder. Never ship this file with real
# credentials inside the frontend build.
NODE_ENV=production
STORAGE_BACKEND=mongo
MONGODB_URI=mongodb://mongo-host.internal:27017/site_builder
MONGODB_DB_NAME=site_builder
SERVER_PORT=3001
SERVER_HOST=127.0.0.1
CORS_ORIGINS=https://portal.army.idf
ADMIN_API_KEY=replace-with-a-server-side-secret
SITE_COLLECTION_PREFIX=site_
LEGACY_SHAREPOINT_READONLY_FALLBACK=false

# Internal file explorer. IIS Windows Authentication supplies the browser identity
# to the loopback Node process through the trusted header below. Model A is used:
# the Node/App Pool service identity reads the approved UNC root.

# If authentication is embedded in MONGODB_URI, keep the real URI only in the
# server environment/secret manager. No MONGODB_* value may use a VITE_ prefix.
