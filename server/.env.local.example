# Local Mongo started by docker-compose.dev.yml.
MONGODB_URI=mongodb://127.0.0.1:27017/site_builder_dev?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=site_builder_dev
SERVER_PORT=3001
CORS_ORIGINS=https://portal.army.idf,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
STORAGE_BACKEND=mongo
# Must match VITE_SITE_BUILDER_DEV_API_KEY in .env.local. Development only.
ADMIN_API_KEY=dev-local-api-key
SITE_COLLECTION_PREFIX=site_
LEGACY_SHAREPOINT_READONLY_FALLBACK=false
NODE_ENV=development

# ---------------------------------------------------------------------------
# DEV-only local AI engine. SERVER-ONLY. Never exposed to the browser.
#
# These values are read by the Node side of the local development server (the
# Vite dev server plugin and this Express API). They are never bundled by Vite
# and never sent to the client. The route is not even registered when
# NODE_ENV=production, so none of this has any effect on a production build.
#
# Optional machine-local alternative for the secret values:
#   ~/.config/site-builder/dev-ai.env
# Precedence: explicit process/server environment > that file > safe defaults.
# An explicitly supplied, non-empty environment value is never overwritten.

# Master server-side gate. Must be true, together with VITE_DEV_AI_ENABLED in
# .env.local, before the DEV AI engine serves anything.
DEV_AI_ENABLED=false

# ollama | groq | auto
#   ollama - local only, never falls back to the cloud (privacy/offline mode)
#   groq   - cloud only
#   auto   - prefer a healthy local Ollama, fall back to Groq
DEV_AI_PROVIDER=auto

# Local Ollama. Install it yourself; Site Builder never installs it and never
# runs `ollama pull` for you. Pick a multilingual model that handles Hebrew,
# for example a recent qwen or gemma multilingual build, then set it below.
DEV_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
DEV_AI_OLLAMA_MODEL=
# Optional. 0 / unset leaves Ollama's own completion limit alone.
DEV_AI_OLLAMA_NUM_PREDICT=

# Groq. GROQ_API_KEY IS A SERVER-ONLY SECRET.
# It must NEVER appear in a VITE_ variable, in frontend source, in the browser
# bundle, in localStorage or in any runtime config served to the client.
# Browser -> local Site Builder development server -> Groq. Never browser -> Groq.
GROQ_API_KEY=
# Free model availability changes over time; run `npm run dev:ai:models` to list
# the model ids this account can currently use, then set one here. Choose a
# general text model that handles Hebrew and JSON output.
DEV_AI_GROQ_MODEL=
DEV_AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# Reasoning suppression. Site Builder prompts are structured transformations that
# require "JSON only", so a reasoning model's chain of thought must neither
# pollute the content channel nor eat the completion budget.
#   DEV_AI_GROQ_REASONING_FORMAT=hidden  keeps reasoning out of the content
#   DEV_AI_GROQ_REASONING_EFFORT=none    skips reasoning entirely
# A model that does not support one of these is detected from the upstream 400
# and that single parameter is dropped and retried once. Use `off` to never send.
DEV_AI_GROQ_REASONING_FORMAT=hidden
DEV_AI_GROQ_REASONING_EFFORT=none
# Groq's own default (2048) is too small for Site Builder's structured prompts.
# Prompt tokens + this value are charged against the account's tokens-per-minute
# allowance; exceeding it returns 413. Lower this on a small free-tier TPM.
DEV_AI_GROQ_MAX_TOKENS=4096

# Shared limits.
DEV_AI_TIMEOUT_MS=60000
DEV_AI_CONNECT_TIMEOUT_MS=5000
DEV_AI_MAX_INPUT_CHARS=200000
DEV_AI_AUTO_ORDER=ollama,groq
